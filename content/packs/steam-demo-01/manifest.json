  "nightShell": {
    "prologue": {
      "lines": [
        {
          "speaker": "林旭阳",
          "type": "background",
          "text": "我叫林旭阳，三十三岁。以前在一家互联网大厂做法务。失业以后，阴差阳错开了这个直播间。不温不火，也做了两年半。我老婆是我大学同学，现在是执业律师。"
        },
        {
          "speaker": "运营 · 老方（工作消息）",
          "type": "notice",
          "text": "深夜档这个月再不达标，就并进娱乐区。改版方案，下周一前给我。"
        },
        {
          "speaker": "旁白",
          "type": "narration",
          "text": "晚上八点，你推开直播间的门。走廊坏着半截灯，桌上的显示器还亮着。"
        },
        {
          "speaker": "领导（老婆）",
          "type": "message",
          "text": "吃饭没有？汤在冰箱，记得热。还有个东西我塞你包里了，忙完再看。"
        },
        {
          "speaker": "旁白",
          "type": "stage",
          "text": "你点下“开始直播”。屏幕上的三秒倒计时归零，开播提示音响了一声。",
          "audioCueId": "sfx.broadcast.on-air"
        }
      ],
      "hostLine": {
        "speaker": "主播·林旭阳",
        "type": "host",
        "text": "改版又催上了，先让他催着。开播了哈，今天继续连麦。"
      }
    },
    "interludes": [
      {
        "afterCaseId": "01-credit",
        "kicker": "第一案 · 小尾声",
        "lines": [
          {
            "speaker": "赵律师",
            "role": "advisor",
            "text": "你今天直播里提到的宸直信托，我知道。最近我手上就有好几起跟他们有关的兑付纠纷。"
          },
          {
            "speaker": "林旭阳",
            "role": "host",
            "text": "已经兑不出来了？"
          },
          {
            "speaker": "赵律师",
            "role": "advisor",
            "text": "有纠纷，不等于全线违约。不过我看过几份合同，收益写得很高，钱又去了商场、地产，还有几家关联公司。"
          },
          {
            "speaker": "林旭阳",
            "role": "host",
            "text": "我记得这家公司什么都做，盘子也很大。"
          },
          {
            "speaker": "赵律师",
            "role": "advisor",
            "text": "老板路子很广，业务铺得也开。可盘子大，不等于自己的钱多。至少我经手的几个项目，主要靠一轮一轮往外融。"
          },
          {
            "speaker": "林旭阳",
            "role": "host",
            "text": "那今天这二十万呢？"
          },
          {
            "speaker": "赵律师",
            "role": "advisor",
            "text": "产品、合同、到期日都没看见。现在只能说风险高，你别先替人宣布拿不回。"
          },
          {
            "speaker": "林旭阳",
            "role": "host",
            "text": "行，我收回。"
          },
          {
            "speaker": "赵律师",
            "role": "advisor",
            "text": "那我问个不用证据的。我要是也这么爱面子、花钱没数，你会不会什么都给我买？"
          },
          {
            "speaker": "林旭阳",
            "role": "host",
            "text": "真那样的话，我们俩大概一开始就看不上对方。"
          }
        ],
      "line": "你笑了一下。赵律师把一杯热水推到你手边。",
        "afterLines": [
          {
            "role": "stage",
            "text": "监听音箱里的音乐慢慢起来。第一案完。"
          }
        ],
        "transitionQuote": {
          "text": "祸莫大于不知足，咎莫大于欲得。",
          "source": "老子 ·《道德经》第四十六章",
          "bridge": "账单合上以后，后台又弹出一张店里的表。"
        }
      },
      {
        "afterCaseId": "02-tony",
        "kicker": "第二案 · 小尾声",
        "lines": [
          {
            "speaker": "老方（语音）",
            "role": "production",
            "text": "他店里那个六折，我现在去还算数吗？"
          },
          {
            "speaker": "林旭阳",
            "role": "host",
            "text": "你真想剪就正常约。别为了六折，顺便认个自己人。"
          },
          {
            "speaker": "老方（语音）",
            "role": "production",
            "text": "那算了。别把我加群里。"
          }
        ],
        "line": "老方撤回一张预约截图，像是什么都没问过。",
        "afterLines": [
          {
            "role": "stage",
            "text": "广告音乐换成一段轻一点的钢琴。第二案完。"
          }
        ],
        "transitionQuote": {
          "text": "巧言令色，鲜矣仁。",
          "source": "孔子 ·《论语·学而》",
          "bridge": "老方撤回了预约截图。下一张后台图片来自一位介绍人。"
        }
      },
      {
        "afterCaseId": "03-profile",
        "kicker": "第三案 · 小尾声",
        "lines": [
          {
            "speaker": "赵律师（语音）",
            "role": "advisor",
            "text": "你刚才说的那笔宸直，女方家买的是哪一款？"
          },
          {
            "speaker": "林旭阳",
            "role": "host",
            "text": "我只看见持有页，三十万，写着九月底到期。合同没上屏。"
          },
          {
            "speaker": "赵律师（语音）",
            "role": "advisor",
            "text": "那现在只能说没到期，不能说拿不回来。宸直老板确实挺能折腾，商场、地产、理财，什么都做。摊子看着大，里面不少钱都是融来的。"
          },
          {
            "speaker": "林旭阳",
            "role": "host",
            "text": "她家已经把九月底的钱算进婚礼了。希望到时候真能回来吧。"
          },
          {
            "speaker": "赵律师（语音）",
            "role": "advisor",
            "text": "先别替人家发愁。你第一次去我家的时候，我爸妈要是先问你能拿多少，你还会来吗？"
          },
          {
            "speaker": "林旭阳",
            "role": "host",
            "text": "会。饭还是吃完了，钱也得我自己说。"
          }
        ],
      "line": "语音停了，你把保温盒重新扣好。",
        "afterLines": [
          {
            "role": "stage",
            "text": "热过的汤又凉了。塑料盖轻轻响了一声。第三案完。"
          }
        ],
        "transitionQuote": {
          "text": "名不正，则言不顺；言不顺，则事不成。",
          "source": "孔子 ·《论语·子路》",
          "bridge": "保温盒扣好以后，后台又多了三张没有回单号的审批图。"
        }
      },
      {
        "afterCaseId": "04-workplace",
        "kicker": "第四案 · 小尾声",
        "lines": [
          {
            "speaker": "赵律师",
            "role": "advisor",
            "text": "今晚这些杯子，谁洗？"
          },
          {
            "speaker": "林旭阳",
            "role": "host",
            "text": "我洗。你站旁边监督。"
          },
          {
            "speaker": "赵律师",
            "role": "advisor",
            "text": "不监督。我在门口等你。"
          }
        ],
      "line": "你把备用线缠好，收进桌下的盒子，又端起桌上的杯子。",
        "afterLines": [
          {
            "role": "stage",
            "text": "屏幕右上角的“直播中”灭了。第四案完。"
