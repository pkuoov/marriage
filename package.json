{
  "name": "livestream-detective",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/dev-server.js --open --fresh",
    "dev": "node scripts/dev-server.js",
    "play": "node scripts/dev-server.js --open",
    "play:fresh": "node scripts/dev-server.js --open --fresh",
    "play:windows": "play-windows.bat",
    "content:index": "node scripts/build-content-index.js",
    "content:index:check": "node scripts/build-content-index.js --check",
    "content:script": "node scripts/build-readable-script.js && node scripts/build-character-dialogue-report.js && node scripts/build-dialogue-adjacency-report.js",
    "content:script:check": "node scripts/build-readable-script.js --check && node scripts/build-character-dialogue-report.js --check && node scripts/build-dialogue-adjacency-report.js --check",
    "content:dialogue-report": "node scripts/build-character-dialogue-report.js",
    "content:dialogue-report:check": "node scripts/build-character-dialogue-report.js --check",
    "content:adjacency-report": "node scripts/build-dialogue-adjacency-report.js",
    "content:adjacency-report:check": "node scripts/build-dialogue-adjacency-report.js --check",
    "build:h5": "npm run content:index && node scripts/build-static.js",
    "build:playable": "npm run content:index && node scripts/build-playable.js",
    "build:desktop": "node scripts/build-desktop.js",
    "build:steam": "npm run build:desktop",
    "package:win": "node scripts/assert-windows-package-env.js && npm run build:desktop && electron-builder --win portable --config desktop/electron-builder.json",
    "verify:win-package": "node scripts/verify-windows-package.js",
    "verify:win-runtime-smoke": "node scripts/verify-windows-runtime-smoke.js",
    "steam:preflight": "node scripts/steam-preflight.js",
    "smoke:desktop": "npm run build:desktop && node scripts/smoke-desktop.js",
    "smoke:quick": "npm run build:playable && node scripts/smoke-browser-replay.js --target=local-quick",
    "smoke:browser": "npm run build:playable && node scripts/smoke-browser-replay.js",
    "test": "npm run test:full",
    "test:full": "npm run check && npm run smoke:browser && npm run smoke:desktop",
    "test:local": "npm run check && npm run smoke:quick",
    "test:pr": "npm run check && npm run smoke:browser",
    "test:quick": "npm run content:index:check && npm run test:unit && npm run test:narrative",
    "intel:collect": "node scripts/collect-daily-intelligence.js",
    "intel:drafts": "node scripts/generate-daily-case-drafts.js",
    "intel:creator-template": "node scripts/create-creator-review-template.js",
    "audio:prototype": "node scripts/generate-prototype-audio-assets.js",
    "audio:p1": "node scripts/generate-p1-audio-assets.js",
    "audio:bgm": "node scripts/process-bgm.js",
    "audio:voice": "node scripts/process-dialogue-voice.js",
    "verify:content-pipeline": "node scripts/verify-content-pipeline.js",
    "verify:audio": "node scripts/verify-audio-assets.js",
    "verify:pack": "npm run content:index:check && node scripts/verify-pack.js",
    "test:unit": "node scripts/verify-logic.js",
    "test:logic": "npm run test:unit",
    "test:narrative": "node scripts/verify-narrative-flow.js",
    "check": "node scripts/check-all.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "43.0.0",
    "electron-builder": "26.15.3"
  }
}
