{
  "appId": "com.livestreamdetective.demo",
  "productName": "Livestream Detective Demo",
  "directories": {
    "app": "dist/desktop-electron",
    "output": "dist/steam"
  },
  "files": [
    "**/*"
  ],
  "asar": true,
  "compression": "maximum",
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "LivestreamDetectiveDemo-${version}-${arch}.${ext}"
  },
  "extraMetadata": {
    "name": "livestream-detective-demo",
    "version": "0.1.0",
    "main": "main.cjs"
  }
}
